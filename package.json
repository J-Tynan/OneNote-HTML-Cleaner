{
  "name": "onenote-html-cleaner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:tailwind": "tailwindcss -c tailwind.config.cjs -i ./src/styles/tailwind.css -o ./assets/tailwind-output.css --minify",
    "watch:tailwind": "tailwindcss -c tailwind.config.cjs -i ./src/styles/tailwind.css -o ./assets/tailwind-output.css --watch",
    "tools:regen-cleaned": "node ./tools/regenerate-cleaned.js",
    "fixtures:rebaseline": "node ./tools/rebaseline-locked-fixtures.js",
"test:gate:native": "npm run tools:regen-cleaned && npm run test:charset && npm run test:charset-fallback && npm run test:utf8-encoding && npm run test:idempotence && npm run test:rerun-equivalence && npm run test:obsolete-attrs && npm run test:inline-style-collapse && npm run test:inline-style-normalization && npm run test:contrast-colors && npm run test:style-dependency && npm run test:export-independence && npm run test:pipeline-config && npm run test:toolbar && npm run test:ui-downloads && npm run test:exports:regressions && npm run test:locked-fixtures && npm run test:image-alt && npm run test:smoke:native && npm run test:forbidden-artifacts",
    "test:smoke:native": "node ./Tests/smoke-native.js",
    "test:toolbar": "node ./Tests/toolbar-injector.js",
    "test:semantic:native": "node ./Tests/semantic-native-parser.js",
    "test:metadata:onepkg": "node ./Tests/metadata-onepkg-parser.js",
    "test:warnings:contract": "node ./Tests/warning-code-contract.js",
    "test:ui-downloads": "node ./Tests/ui-downloads-config.js",
    "test:pipeline-config": "node ./Tests/pipeline-config.unit.js",
    "test:ui-download-smoke": "node ./Tests/ui-download-zip-playwright.js",
    "test:sw-update": "node ./Tests/service-worker-update-playwright.js",
    "test:sw-bump": "node ./Tests/sw-bump.js",
    "bump-sw-cache": "node ./scripts/bump-sw-cache.cjs",
    "test:theme": "node ./Tests/tailwind-darkmode.js && node ./Tests/theme-playwright.js",
    "test:playwright:a11y": "node ./Tests/playwright-a11y.js",
    "test:playwright:a11y-exports": "node ./Tests/playwright-a11y-exports.js --dir Tests/Cleaned",
    "test:exports:regressions": "node ./Tests/exports-regressions.js",
    "test:image-alt": "node ./Tests/image-alt.unit.js",
    "test:inline-style-collapse": "node ./Tests/inline-style-collapse.unit.js",
    "test:inline-style-normalization": "node ./Tests/inline-style-normalization.unit.js",
    "test:contrast-colors": "node ./Tests/contrast-color-normalization.unit.js",
    "test:inline-style-threshold-warning": "node ./Tests/inline-style-threshold-warning.unit.js",
    "test:externalize-css": "node ./Tests/externalize-css.unit.js",
    "test:style-dependency": "node ./Tests/style-dependency.unit.js",
    "test:export-independence": "node ./Tests/export-independence.unit.js",
    "test:idempotence": "node ./Tests/check-sanitizer-idempotence.js",
    "test:rerun-equivalence": "node ./Tests/check-rerun-equivalence.js",
    "test:locked-fixtures": "node ./Tests/check-locked-fixtures.js",
    "test:list-fidelity": "node ./Tests/list-fidelity.unit.js",
    "test:obsolete-attrs": "node ./Tests/obsolete-attributes.unit.js",
    "test:forbidden-artifacts": "node ./Tests/check-forbidden-artifacts.js --dir Tests/Cleaned",
    "test:check-c0": "node ./Tests/check-c0-exported.js",
    "test:check-c0-pipeline": "node ./Tests/check-c0-pipeline.js",
    "test:charset": "node ./Tests/check-charset-regressions.js",
    "test:charset-fallback": "node ./Tests/charset-fallback.unit.js",
    "test:mht-inline-image-guardrail": "node ./Tests/mht-inline-image-guardrail.unit.js",
    "test:utf8-encoding": "node ./Tests/check-utf8-encoding.js --dir Tests/Cleaned",
    "test:sanitizer": "node ./Tests/sanitizer-onenote.unit.js",
    "test:worker-handshake": "node ./Tests/worker-handshake-playwright.js",
    "test:worker-init": "node ./Tests/worker-init-playwright.js",
    "test:worker-init-failure": "node ./Tests/worker-init-failure-playwright.js",
    "test:worker-handshake-timeout": "node ./Tests/worker-handshake-timeout-playwright.js",
    "test:unsupported-file": "node ./Tests/unsupported-file-playwright.js",
    "test:import-safety": "node ./Tests/import-safety-playwright.js",
    "test:mht-fixtures": "node ./Tests/mht-fixtures-playwright.js",
    "build:libmspack:wasm": "powershell -ExecutionPolicy Bypass -File ./tools/Build-LibmspackWasm.ps1",
    "build:libmspack:wasm:wsl": "powershell -ExecutionPolicy Bypass -File ./tools/Build-LibmspackWasm-WSL.ps1",
    "build:libmspack:wasm:wsl:check": "powershell -ExecutionPolicy Bypass -File ./tools/Build-LibmspackWasm-WSL.ps1 -CheckOnly",
    "build:libmspack:wasm:smoke": "npm run build:libmspack:wasm && node ./tools/check-libmspack-wasm.js"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "flowbite": "^4.0.1",
    "jszip": "^3.10.1",
    "libarchive.js": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.6.2",
    "@playwright/test": "^1.58.2",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^3.4.17"
  }
}
