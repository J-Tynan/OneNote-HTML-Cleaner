{
  "name": "native-regression-baseline",
  "groups": [
    {
      "label": "mht-exports",
      "folder": ".",
      "minHtmlFiles": 4
    }
  ],
  "requiredFiles": [
    "Communicate using Markdown.html",
    "DevToys.html",
    "Problematic mht-full-snippet.html",
    "Problematic mht-sample.html",
    "Resolve merge conflicts.html",
    "Test File.html"
  ],
  "files": {
    "Communicate using Markdown.html": {
      "mustContain": [
        "<main",
        "<h1"
      ],
      "mustMatch": [
        "<title>\\s*Communicate\\s+using\\s+Markdown\\s*</title>"
      ],
      "mustNotContain": [
        "multipart/related",
        "Single File Web Page"
      ]
    },
    "DevToys.html": {
      "mustContain": [
        "<main",
        "<h1"
      ],
      "mustNotContain": [
        "multipart/related",
        "Single File Web Page"
      ]
    },
    "Problematic mht-full-snippet.html": {
      "mustContain": [
        "<main",
        "<h1"
      ],
      "mustNotContain": [
        "multipart/related",
        "Single File Web Page"
      ]
    },
    "Problematic mht-sample.html": {
      "mustContain": [
        "<main",
        "<h1"
      ],
      "mustNotContain": [
        "multipart/related",
        "Single File Web Page"
      ],
      "minVisibleText": 0
    },
    "Resolve merge conflicts.html": {
      "mustContain": [
        "<main",
        "<h1",
        "<table",
        "<ol"
      ],
      "mustMatch": [
        "<title>\\s*Resolve\\s+merge\\s+conflicts\\s*</title>"
      ],
      "mustNotContain": [
        "multipart/related",
        "Single File Web Page"
      ],
      "mustNotMatch": [
        "src\\s*=\\s*[\"'](?:cid:|file:///)"
      ]
    },
    "Test File.html": {
      "mustContain": [
        "<main",
        "<h1",
        "<table"
      ],
      "mustNotContain": [
        "multipart/related",
        "Single File Web Page"
      ],
      "mustNotMatch": [
        "src\\s*=\\s*[\"'](?:cid:|file:///)"
      ]
    }
  }
}
