# Keep committed markdown smoke outputs and report baselines visible.
# These trees contain reviewed fixtures/artifacts in addition to local rerun output.

# Large binary fixtures/screenshots created by local test runs.
# Consider moving these to a separate fixtures repo or using Git LFS
# to avoid inflating the main repository history.
Tests/OneNote originals/*.png
Tests/OneNote originals/*.jpg
Tests/OneNote originals/*.jpeg
Tests/OneNote originals/*.gif
Tests/screenshots/

# Untracked generated exports used during local test runs
Tests/exports-processed/

# Playwright / headless test artifacts
playwright-report/
.playwright/
test-results/
screenshots/
video/



